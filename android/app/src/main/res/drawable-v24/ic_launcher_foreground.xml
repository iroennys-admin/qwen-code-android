<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer glow halo -->
    <path
        android:pathData="M54 18 L86 54 L54 90 L22 54 Z"
        android:fillAlpha="0.20">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="54"
                android:gradientRadius="48"
                android:startColor="#7c8cff"
                android:endColor="#00000000" />
        </aapt:attr>
    </path>

    <!-- Main diamond (aurora gradient) -->
    <path
        android:pathData="M54 26 L78 54 L54 82 L30 54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="30" android:startY="26"
                android:endX="78" android:endY="82">
                <item android:offset="0" android:color="#7c8cff" />
                <item android:offset="0.5" android:color="#b384ff" />
                <item android:offset="1" android:color="#5ee5d3" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Highlight (top-left) -->
    <path
        android:pathData="M54 30 L66 44 L54 58 L42 44 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.30" />

    <!-- Inner line -->
    <path
        android:pathData="M54 36 L66 54 L54 72 L42 54 Z"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.55"
        android:strokeWidth="1.5"
        android:fillColor="#00000000" />
</vector>
