{
  "name": "opencode-android",
  "version": "1.0.0",
  "description": "OpenCode AI Coding Agent for Android",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:init": "npx cap init 'OpenCode' com.opencode.android --web-dir dist",
